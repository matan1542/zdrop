#!/bin/sh
# zdrop launcher. Runs Node with flags that keep the daemon's memory small:
# a 1 MB young generation, size-optimised heuristics and a hard 96 MB old-space ceiling.
set -e

# resolve symlinks (e.g. ~/.local/bin/zdrop -> ~/.zdrop/current/bin/zdrop) to find the install
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

# releases bundle their own Node.js; a source checkout uses the one on PATH
node="$root/runtime/node"
[ -x "$node" ] || node=node
node_flags="--max-semi-space-size=1 --optimize-for-size --max-old-space-size=96"
home=${ZDROP_HOME:-$HOME/.cache/zdrop}
repo="matan1542/zdrop"
# installed by Homebrew: brew owns updates and removing the files
brewed=0
case "$root" in */Cellar/zdrop/*) brewed=1 ;; esac
# the install path that survives updates: brew's opt/ link (the Cellar path is per version), or the
# installer's current/ link
case "$root" in
  */Cellar/zdrop/*) stable="${root%%/Cellar/zdrop/*}/opt/zdrop/libexec" ;;
  */versions/*) stable="${root%/versions/*}/current" ;;
  *) stable="$root" ;;
esac
# the login item `zdrop setup` adds: a LaunchAgent on macOS, a systemd user unit on Linux
label="io.github.matan1542.zdrop"
plist="$HOME/Library/LaunchAgents/$label.plist"
unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/zdrop.service"
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
# a value inside a systemd Environment="..." assignment
unit_value() { printf '%s' "$1" | sed -e 's/%/%%/g' -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
sha256_check() { if command -v shasum >/dev/null; then shasum -a 256 -c "$1"; else sha256sum -c "$1"; fi; }
# rewrite a file in place through a symlink (a dotfiles-managed ~/.zshrc stays a symlink)
rewrite() { cat "$1.zdrop-tmp" >"$1" && rm -f "$1.zdrop-tmp"; }

# The daemon starts at login and stays up while logged in (no idle exit); a crash is restarted.
# It is handed this shell's PATH: the login environment's is bare, and a source checkout needs node.
login_install() {
  mkdir -p "$home"
  case "$(uname -s)" in
    Darwin)
      mkdir -p "$(dirname "$plist")"
      cat >"$plist.tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array><string>$(xml "$stable/bin/zdrop")</string><string>serve</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml "$PATH")</string>
    <key>HISTFILE</key><string>$(xml "${HISTFILE:-$HOME/.zsh_history}")</string>
    <key>ZDROP_HOME</key><string>$(xml "$home")</string>
    <key>ZDROP_LOGIN</key><string>1</string>
    <key>ZDROP_IDLE_MINUTES</key><string>0</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>$(xml "$home/daemon.out")</string>
  <key>StandardErrorPath</key><string>$(xml "$home/daemon.out")</string>
</dict>
</plist>
PLIST
      mv -f "$plist.tmp" "$plist"
      # (re)load it: an update points it at the new code and starts the new daemon now
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      if launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null; then
        echo "zdrop now starts when you log in"
      else
        echo "zdrop starts when you log in (from the next login)"
      fi
      ;;
    *)
      if ! command -v systemctl >/dev/null || ! systemctl --user show-environment >/dev/null 2>&1; then
        echo "no systemd user session: the daemon starts on your first keystroke instead"
        return 0
      fi
      mkdir -p "$(dirname "$unit")"
      cat >"$unit.tmp" <<UNIT
[Unit]
Description=zdrop autocomplete daemon

[Service]
ExecStart="$(unit_value "$stable/bin/zdrop")" serve
Environment="PATH=$(unit_value "$PATH")" "HISTFILE=$(unit_value "${HISTFILE:-$HOME/.zsh_history}")" "ZDROP_HOME=$(unit_value "$home")" ZDROP_LOGIN=1 ZDROP_IDLE_MINUTES=0
Restart=on-failure
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
UNIT
      mv -f "$unit.tmp" "$unit"
      systemctl --user daemon-reload
      if systemctl --user enable zdrop.service >/dev/null 2>&1 && systemctl --user restart zdrop.service; then
        echo "zdrop now starts when you log in"
      else
        echo "could not enable $unit: the daemon starts on your first keystroke instead"
      fi
      ;;
  esac
}

login_remove() {
  if [ -f "$plist" ]; then
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    rm -f "$plist"
  fi
  if [ -f "$unit" ]; then
    systemctl --user disable --now zdrop.service >/dev/null 2>&1 || true
    rm -f "$unit"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
}

# the comment setup writes above its line in ~/.zshrc, and a pattern for every wording it has had
marker="# zdrop: dropdown autocomplete (keep this last)"
markers='^# zdrop: [A-Za-z -]* autocomplete (keep this last)$'

case "${1:-}" in
  start)
    # detached from the terminal; the daemon itself refuses to start twice
    mkdir -p "$home"
    # keep daemon.out under 1 MB (the previous one is kept as .1)
    [ -f "$home/daemon.out" ] && [ "$(wc -c <"$home/daemon.out")" -gt 1048576 ] && mv -f "$home/daemon.out" "$home/daemon.out.1"
    nohup "$node" $node_flags "$root/dist/src/cli.js" serve >>"$home/daemon.out" 2>&1 </dev/null &
    ;;
  setup)
    # Turns zdrop on: the source line at the end of ~/.zshrc, and a login item that starts the daemon
    # when you log in (so the first keystroke finds it warm and commands are learned in the background).
    # The installer runs this; Homebrew users run it once. ZDROP_NO_RC=1 / ZDROP_NO_LOGIN=1 skip a part.
    if [ "${ZDROP_NO_RC:-0}" != 1 ]; then
      zshrc="${ZDOTDIR:-$HOME}/.zshrc"
      line="source \"$stable/zsh/zdrop.plugin.zsh\""
      touch "$zshrc"
      # an older release wrote the marker with different wording: bring it up to date
      if grep -q "$markers" "$zshrc" && ! grep -qxF "$marker" "$zshrc"; then
        sed "s|$markers|$marker|" "$zshrc" >"$zshrc.zdrop-tmp" && rewrite "$zshrc"
      fi
      if grep -qxF "$line" "$zshrc"; then
        echo "$zshrc already loads zdrop"
      else
        # keep the oldest backup when run twice in a second
        backup="$zshrc.bak-zdrop-$(date +%Y%m%d%H%M%S)"
        [ -e "$backup" ] || cp "$zshrc" "$backup"
        # another copy of zdrop (a git checkout, an older install) would load twice: comment it out
        if grep -q '^[^#]*zdrop\.plugin\.zsh' "$zshrc"; then
          sed 's|^\([^#]*zdrop\.plugin\.zsh.*\)$|# \1  # replaced by zdrop setup|' "$zshrc" >"$zshrc.zdrop-tmp" && rewrite "$zshrc"
          echo "commented out an older zdrop line in $zshrc"
        fi
        grep -qxF "$marker" "$zshrc" || printf '\n%s\n' "$marker" >>"$zshrc"
        printf '%s\n' "$line" >>"$zshrc"
        echo "added zdrop to $zshrc (backup saved next to it)"
      fi
    fi
    [ "${ZDROP_NO_LOGIN:-0}" = 1 ] || login_install
    echo "Open a new terminal tab (or run: exec zsh)."
    ;;
  version | --version | -v)
    cat "$root/VERSION" 2>/dev/null || "$node" -p "require('$root/package.json').version + ' (source)'"
    ;;
  update)
    [ $brewed = 1 ] && { echo "installed with Homebrew: brew upgrade zdrop"; exit 0; }
    shift
    curl -fsSL "https://github.com/$repo/releases/latest/download/install.sh" | ZDROP_VERSION="${1:-latest}" sh
    ;;
  extras)
    # the aws, gcloud and az specs: large, so not in the main download
    [ "${2:-}" = install ] || { echo "usage: zdrop extras install" >&2; exit 1; }
    version=$(cat "$root/VERSION" 2>/dev/null) || { echo "zdrop extras: only for release installs (a source checkout already has them)" >&2; exit 1; }
    asset="zdrop-heavy-specs-$version.tar.xz"
    base="https://github.com/$repo/releases/download/v$version"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fL --retry 3 --progress-bar "$base/$asset" -o "$tmp/$asset"
    curl -fsSL --retry 3 "$base/$asset.sha256" -o "$tmp/$asset.sha256"
    (cd "$tmp" && sha256_check "$asset.sha256" >/dev/null) || { echo "checksum mismatch: not installed" >&2; exit 1; }
    tar -xf "$tmp/$asset" -C "$root/node_modules/@withfig/autocomplete/build"
    "$node" $node_flags "$root/dist/src/cli.js" stop >/dev/null 2>&1 || true
    echo "aws, gcloud and az specs installed. Turn them on with: export ZDROP_HEAVY_SPECS=1 (in ~/.zshrc, before zdrop)"
    ;;
  uninstall)
    "$node" $node_flags "$root/dist/src/cli.js" stop >/dev/null 2>&1 || true
    login_remove
    zshrc="${ZDOTDIR:-$HOME}/.zshrc"
    if [ -f "$zshrc" ] && grep -q "$stable/zsh/zdrop.plugin.zsh\|$markers" "$zshrc"; then
      cp "$zshrc" "$zshrc.bak-zdrop-$(date +%Y%m%d%H%M%S)"
      grep -v "$stable/zsh/zdrop.plugin.zsh\|$markers" "$zshrc" >"$zshrc.zdrop-tmp"; rewrite "$zshrc"
      echo "removed zdrop from $zshrc (backup saved next to it)"
    fi
    rm -rf "$home"
    if [ $brewed = 1 ]; then
      echo "zdrop is turned off. Finish with: brew uninstall zdrop"
      exit 0
    fi
    prefix=${ZDROP_PREFIX:-$HOME/.zdrop}
    [ "$(readlink "$HOME/.local/bin/zdrop" 2>/dev/null)" = "$prefix/current/bin/zdrop" ] && rm -f "$HOME/.local/bin/zdrop"
    case "$root" in "$prefix"/*) rm -rf "$prefix" ;; esac
    echo "zdrop uninstalled. Open a new terminal tab."
    ;;
  *)
    exec "$node" $node_flags "$root/dist/src/cli.js" "$@"
    ;;
esac
